# ==============================================================================
# Local AI Discord Bot - Configuration Template
# ==============================================================================

# [Required] Discord Bot Token from Discord Developer Portal
# Obtain from: https://discord.com/developers/applications -> Bot -> Token
# NOTE: Ensure "MESSAGE CONTENT INTENT" is toggled ON under Privileged Gateway Intents!
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# [Optional] Local OpenAI-compatible inference endpoint
# Default Ollama: http://localhost:11434/v1
# Default OpenVINO / vLLM: http://localhost:8000/v1
# Default LM Studio: http://localhost:1234/v1
LOCAL_LLM_URL=http://localhost:11434/v1

# [Optional] Target quantized model identifier
# Recommended for sub-5GB VRAM: gemma2:2b, gemma:2b, phi3:mini, qwen2.5:1.5b, qwen2.5:3b
MODEL_NAME=gemma2:2b

# [Optional] Generation parameters (tuned for sub-5GB VRAM & low latency)
MAX_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9
INFERENCE_TIMEOUT_SECONDS=60.0

# [Optional] Bot Command Prefix (Default: !)
COMMAND_PREFIX=!

# [Optional] Web context search configuration (Zero API key DuckDuckGo HTML)
SEARCH_ENABLED=true
SEARCH_MAX_RESULTS=3
SEARCH_TIMEOUT_SECONDS=5.0
MAX_SNIPPET_LENGTH=250

# [Optional] System Persona Override
# Leave commented to use the built-in concise & factual persona
# SYSTEM_PERSONA="You are a fast, knowledgeable, and privacy-conscious local AI assistant..."
